@model Project.Application.DTOs.Server.CreateServerDTO
@{
    Layout = "_Admin";
}

@section vendors{
    <script src="~/app-assets/vendors/js/vendors.min.js"></script>
    <!-- BEGIN Vendor JS-->
    <!-- BEGIN: Page Vendor JS-->
    <script src="~/app-assets/vendors/js/tables/datatable/pdfmake.min.js"></script>
    <script src="~/app-assets/vendors/js/tables/datatable/vfs_fonts.js"></script>
    <script src="~/app-assets/vendors/js/tables/datatable/datatables.min.js"></script>
    <script src="~/app-assets/vendors/js/tables/datatable/datatables.buttons.min.js"></script>
    <script src="~/app-assets/vendors/js/tables/datatable/buttons.html5.min.js"></script>
    <script src="~/app-assets/vendors/js/tables/datatable/buttons.print.min.js"></script>
    <script src="~/app-assets/vendors/js/tables/datatable/buttons.bootstrap.min.js"></script>
    <script src="~/app-assets/vendors/js/tables/datatable/datatables.bootstrap4.min.js"></script>
    <!-- END: Page Vendor JS-->
    <!-- BEGIN: Theme JS-->
    <script src="~/app-assets/js/core/app-menu.js"></script>
    <script src="~/app-assets/js/core/app.js"></script>
    <script src="~/app-assets/js/scripts/components.js"></script>
    <!-- END: Theme JS-->
    <!-- BEGIN: Page JS-->
    <script src="~/adminJs/server.js"></script>
}

    @section scripts{
    <script>
        getservers(false);
    </script>
}

    @section vendorstyles{
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/vendors-rtl.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/datatables.min.css">
    <!-- END: Vendor CSS-->
    <!-- BEGIN: Theme CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/bootstrap-extended.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/colors.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/components.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/themes/dark-layout.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/themes/semi-dark-layout.css">

    <!-- BEGIN: Page CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/core/menu/menu-types/vertical-menu.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/core/colors/palette-gradient.css">
    <!-- END: Page CSS-->
    <!-- BEGIN: Custom CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/custom-rtl.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/fontawesome/font-awesome.min.css">
}
    <div class="content-body">
        <section id="horizontal-vertical">
            <div class="row">
                <div class="col-12">
                    <div class="card row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <br/>
                                    <h4 class="card-title">
                                         لیست سرور ها
                                    </h4>
                                    <br/>
                                    <br />

                                    <button class="btn btn-success" onclick="newserver()">
                                        جدید
                                    </button>
                                    <br />

                                    <button class="btn btn-danger ml-2" onclick="DeleteSelectedItems(serversBaseUrl, getservers, false)">
                                         حذف
                                    </button>
                                    <br />

                                    <button class="btn btn-primary ml-2" onclick="filterservers()">
                                         فیلتر
                                    </button>
                                    <br />

                                    <button class="btn btn-warning" onclick="goDomain()">
                                         دامنه ها
                                    </button>
                                    <br/>
                                </div>

                                <div class="card-content">
                                    <div class="card-body card-dashboard">
                                        <div class="table-responsive">
                                            <table class="table nowrap scroll-horizontal-vertical" style="width:100%!important" id="serversTable">
                                                <thead>
                                                    <tr>
                                                        <th scope="col"></th>
                                                        <th scope="col">Id</th>
                                                        <th scope="col">isAdServer</th>
                                                        <th scope="col">Domain</th>
                                                        <th scope="col">HostName</th>
                                                        <th scope="col">Location</th>
                                                        <th scope="col">Ip</th>
                                                        <th scope="col">GroupTitle</th>
                                                        <th scope="col">IsAvailable</th>
                                                        <th scope="col">isForHamraheAvval</th>
                                                        <th scope="col">IsForIrancell</th>
                                                        <th scope="col">AllLogsStatistics</th>
                                                        <th scope="col">IrancellLogsStatistics</th>
                                                        <th scope="col">HamraheAvvalLogsStatistics</th>
                                                        <th scope="col">UnknownLogsStatistics</th>
                                                        <th></th>
                                                        <th></th>
                                                        <th></th>
                                                        <th></th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                            <input type="hidden" hidden id="selectedgroupId" value="@ViewBag.GroupId" />
                                            <input type="hidden" hidden id="selectedappId" value="@ViewBag.AppId" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>

    <div class="modal fade" id="serversModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Create server</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="serverForm">
                        <div class="form-group">
                            <label asp-for="ServerName"></label> 
                            <input asp-for="ServerName" type="text" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label asp-for="Location"></label>
                            <input asp-for="Location" type="text" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label asp-for="Ip"></label>
                            <input asp-for="Ip" type="text" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label asp-for="Config"></label>
                            <textarea rows="6" asp-for="Config" type="text" class="form-control" required></textarea>
                        </div>
                        <div class="form-group">
                            <label asp-for="ConfigKey"></label>
                            <input asp-for="ConfigKey" type="text" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label asp-for="ConfigValue"></label>
                            <input asp-for="ConfigValue" type="text" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label asp-for="CurrentDomainValue"></label>
                            <input asp-for="CurrentDomainValue" type="text" class="form-control" required>
                        </div>
                        <div id="groupSelectListArea" class="form-group">
                            <label asp-for="GroupId">Select Group</label>
                            <select class="form-control" asp-for="GroupId"></select>
                        </div>

                        <div class="form-group">
                            <label asp-for="IsForHamraheAvval"></label>
                            <select class="form-control" asp-for="IsForHamraheAvval">
                                <option value="false">false</option>
                                <option value="true">true</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="IsForIrancell"></label>
                            <select class="form-control" asp-for="IsForIrancell">
                                <option value="false">false</option>
                                <option value="true">true</option>
                            </select>
                        </div>
                        <input hidden id="itemId" name="itemId" />
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-dismiss="modal">لغو</button>
                    <button onclick="submitForm()" type="button" class="btn btn-success">تایید</button>
                </div>
            </div>
        </div>
    </div>
<div class="modal fade" id="filterserversModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Filter server</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="filterServerForm">
                    <div class="form-group">
                        <label>Choose what to show</label>
                        <select class="form-control" name="filter" id="filterInput">
                            <option value="0">All</option>
                            <option value="1">Is Available</option>
                            <option value="2">Not Available</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">لغو</button>
                <button onclick="filter()" type="button" class="btn btn-success">تایید</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="filterserversModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Filter server</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="filterServerForm">
                    <div class="form-group">
                        <label>Choose what to show</label>
                        <select class="form-control" name="filter" id="filterInput">
                            <option value="0">All</option>
                            <option value="1">Is Available</option>
                            <option value="2">Not Available</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">لغو</button>
                <button onclick="filter()" type="button" class="btn btn-success">تایید</button>
            </div>
        </div>
    </div>
</div>


