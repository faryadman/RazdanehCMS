<div class="content-body">
    <section id="horizontal-vertical">
        <div class="row">
            <div class="col-12">
                <div class="card row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                                            <div class="rd-toolbar">
                                                                <div class="rd-tb-title"><span class="rd-tb-bar" aria-hidden="true"></span><h4 class="card-title mb-0">لیست سرور ها تبلیغاتی</h4></div>
                                                                <div class="rd-tb-group rd-tb-main" role="group" aria-label="عملیات اصلی">
                                                                <button class="btn btn-success rd-tb-btn" onclick="newserver()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></i>جدید</button>
                                                                <button class="btn btn-danger rd-tb-btn" onclick="DeleteSelectedItems(serversBaseUrl, getservers, false)"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></i>حذف</button>
                                                                <button class="btn btn-primary rd-tb-btn" onclick="filterservers()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg></i>فیلتر</button>
                                                                </div>
                                                                <span class="rd-tb-sep rd-tb-sep-bulk" aria-hidden="true"></span>
                                                                    <button type="button" class="rd-tb-bulk-toggle" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>عملیات</button>
                                                                    <div class="rd-tb-bulk">
                                                                    <div class="rd-tb-group" role="group" aria-label="لیست‌ها">
                                                                <button class="btn btn-warning rd-tb-btn" onclick="goDomain()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></i><wbr>دامنه ها</button>
                                                                <button class="btn btn-adn rd-tb-btn" onclick="goIpList()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg></i>ip سرور ها</button>
                                                                </div>
                                                                <span class="rd-tb-sep" aria-hidden="true"></span>
                                                                <div class="rd-tb-group" role="group" aria-label="عملیات گروهی">
                                                                <button class="btn btn-outline-success rd-tb-btn" onclick="RefreshDomainSelectedItems(serversBaseUrl, getservers, false)"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg></i>رفرش دامنه ها</button>
                                                                <button class="btn btn-outline-info rd-tb-btn" onclick="RefreshSubDomainSelectedItems(serversBaseUrl, getservers, false)"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg></i>رفرش زیردامنه ها</button>
                                                                <button class="btn btn-outline-danger rd-tb-btn" onclick="DnsDeleteSelectedItems(serversBaseUrl, getservers, false)"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></i>حذف dns ها</button>
                                                                <button class="btn btn-outline-warning rd-tb-btn" onclick="onClickChangeServerAddresses()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></i>تنظیم آدرس همه سرور ها</button>
                                                                </div>
                                                            </div>
                                                                </div>
                                    <span class="rd-tb-sep" aria-hidden="true"></span>
                                    <div class="rd-tb-group rd-tb-tools">
                                        <div class="rd-search-box"><i class="rd-search-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></i><input type="text" id="rdSearchInput" placeholder="جستجو: نام، IP، DNS، گروه، مکان..." autocomplete="off"></div>
                                        <div class="rd-view-toggle" role="group" aria-label="نمایش سرورها">
                                            <button type="button" class="rd-view-btn" data-rd-view="list" title="نمایش لیستی"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></button>
                                            <button type="button" class="rd-view-btn" data-rd-view="cards" title="نمایش کارت‌بندی"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></button>
                                        </div>
                                    </div>
                                                        </div>

                            <div class="card-content">
                                <div class="card-body card-dashboard">
                                    <div class="table-responsive">
                                        <table class="table nowrap scroll-horizontal-vertical" style="width: 100% !important" id="serversTable">

                                            <thead>
                                                <tr>
                                                    <th style="width:38px"></th>
                                                    <th scope="col">Id</th>
                                                    <th scope="col">تبلیغاتی</th>
                                                    <th scope="col">DNS</th>
                                                    <th scope="col" style="width:70px">عملیات</th>
                                                    <th scope="col">سرور</th>
                                                    <th scope="col">مکان</th>
                                                    <th scope="col">IP</th>
                                                    <th scope="col">گروه</th>
                                                    <th scope="col">وضعیت</th>
                                                    <th scope="col">همراه اول</th>
                                                    <th scope="col">ایرانسل</th>
                                                    <th scope="col">آمار لاگ‌ها</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                        <input type="hidden" hidden id="selectedgroupId" value="@ViewBag.GroupId" />
                                        <input type="hidden" hidden id="selectedappId" value="@ViewBag.AppId" />
                                    </div>
                                            <div id="rdCardsWrap"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>

<div class="modal fade" id="serversModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Create server</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="serverForm">
                    <div class="form-group">
                        <label asp-for="ServerName"></label>
                        <input asp-for="ServerName" type="text" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label asp-for="Location"></label>
                        <input asp-for="Location" type="text" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label asp-for="Ip"></label>
                        <input asp-for="Ip" type="text" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label asp-for="Config"></label>
                        <textarea style="direction: ltr; text-align: left;" rows="6" asp-for="Config" type="text" class="form-control" required></textarea>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfigKey"></label>
                        <input asp-for="ConfigKey" type="text" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfigValue"></label>
                        <input asp-for="ConfigValue" type="text" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label asp-for="CurrentDomainValue"></label>
                        <input asp-for="CurrentDomainValue" type="text" class="form-control" required>
                    </div>
                    <div id="groupSelectListArea" class="form-group">
                        <label asp-for="GroupId">Select Group</label>
                        <select class="form-control" asp-for="GroupId"></select>
                    </div>

                    <div class="form-group">
                        <label asp-for="IsForHamraheAvval"></label>
                        <select class="form-control" asp-for="IsForHamraheAvval">
                            <option value="false">false</option>
                            <option value="true">true</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="IsForIrancell"></label>
                        <select class="form-control" asp-for="IsForIrancell">
                            <option value="false">false</option>
                            <option value="true">true</option>
                        </select>
                    </div>
                    <input hidden id="itemId" name="itemId" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">لغو</button>
                <button onclick="submitAdForm()" type="button" class="btn btn-success">تایید</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="filterserversModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Filter server</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="filterServerForm">
                    <div class="form-group">
                        <label>Choose what to show</label>
                        <select class="form-control" name="filter" id="filterInput">
                            <option value="0">All</option>
                            <option value="1">Is Available</option>
                            <option value="2">Not Available</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">لغو</button>
                <button onclick="filter()" type="button" class="btn btn-success">تایید</button>
            </div>
        </div>
    </div>
</div>

