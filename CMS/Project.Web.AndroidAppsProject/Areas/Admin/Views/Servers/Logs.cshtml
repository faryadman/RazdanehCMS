    @section scripts{
    <script>
        getlogs();
    </script>
}

    @section vendorstyles{
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/vendors-rtl.min.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/vendors/css/tables/datatable/datatables.min.css">
    <!-- END: Vendor CSS-->
    <!-- BEGIN: Theme CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/bootstrap-extended.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/colors.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/components.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/themes/dark-layout.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/themes/semi-dark-layout.css">

    <!-- BEGIN: Page CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/core/menu/menu-types/vertical-menu.css">
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/core/colors/palette-gradient.css">
    <!-- END: Page CSS-->
    <!-- BEGIN: Custom CSS-->
    <link rel="stylesheet" type="text/css" href="~/app-assets/css-rtl/custom-rtl.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/style-rtl.css">
}
    <div class="content-body">
        <section id="horizontal-vertical">
            <div class="row">
                <div class="col-12">
                    <div class="card row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">لیست لاگ ها</h4>
                                    <hr />
                                    <button class="btn btn-info" onclick="getCronJobInfo()">تنظیمات کرون جاب</button>
                                    <br />
                                    <button class="btn btn-danger ml-3" onclick="massDelete()">حذف همه</button>
                                </div>
                                <div class="card-content">
                                    <div class="card-body card-dashboard">
                                        <div class="table-responsive">
                                            <table class="table nowrap scroll-horizontal-vertical" style="width:100%!important" id="logsTable">
                                                <thead>
                                                    <tr>
                                                        <th scope="col"></th>
                                                        <th scope="col">Id</th>
                                                        <th scope="col">Operator</th>
                                                        <th scope="col">loged Ip</th>
                                                        <th scope="col">Country</th>
                                                        <th scope="col">Isp</th>
                                                        <th scope="col">City</th>
                                                        <th scope="col">Org</th>
                                                        <th scope="col">UserId</th>
                                                        <th scope="col">UpdatedAt</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                            <input type="hidden" hidden id="selectedserverId" value="@ViewBag.ServerId" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>
    <div class="modal fade" id="cronJobInfoModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">CronJob Info</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="CronJobInfoForm">
                        <div class="form-group">
                            <label>Timer</label>
                            <input name="Timer" id="Timer" type="text" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>ExecutedCount</label>
                            <input disabled name="ExecutedCount" id="ExecutedCount" type="text" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>LastExecutionDate</label>
                            <input disabled name="LastExecutionDate" id="LastExecutionDate" type="text" class="form-control" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-dismiss="modal">لغو</button>
                    <button onclick="submitForm()" type="button" class="btn btn-success">تایید</button>
                </div>
            </div>
        </div>
    </div>