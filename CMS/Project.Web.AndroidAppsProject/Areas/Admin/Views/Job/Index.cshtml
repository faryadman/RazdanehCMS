@section scripts{
    <script>
        disableFields();
    </script>
}
<div class="content-body">
    <section id="horizontal-vertical">
        <div class="row">
            <div class="col-12">
                <div class="card row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                                            <div class="rd-toolbar rd-job-tb">
                                                                <div class="rd-tb-title"><span class="rd-tb-bar" aria-hidden="true"></span><h4 class="card-title mb-0">مدیریت جاب ها <span class="rd-tb-count">@(data != null && data.Any() ? new string(data.Count.ToString().Select(ch => "۰۱۲۳۴۵۶۷۸۹"[ch - '0']).ToArray()) : "۰")</span></h4></div>
                                                                <div class="rd-tb-group" role="group" aria-label="جاب‌های دوره‌ای">
                                                                    <button class="btn btn-success rd-tb-btn" type="button" title="Change Domain Job" onclick="jobDomain()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></i>تغییر جاب دامنه</button>
                                                                    <button class="btn btn-success rd-tb-btn" type="button" title="Change SubDomain Job" onclick="jobSubDomain()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg></i>تغییر جاب زیردامنه</button>
                                                                    <button class="btn btn-success rd-tb-btn" type="button" title="Job IpConfigJob" onclick="jobIpConfigJob()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></i>تغییر جاب IpConfig</button>
                                                                </div>
                                                                <span class="rd-tb-sep" aria-hidden="true"></span>
                                                                <div class="rd-tb-group" role="group" aria-label="پاک‌سازی DNS">
                                                                    <button class="btn btn-danger rd-tb-btn" type="button" title="Delete Dns Records (CNAME)" onclick="jobDeleteDnsJob()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></i>حذف رکوردهای DNS (CNAME)</button>
                                                                </div>
                                                                @*<button class="btn btn-success rd-tb-btn" type="button" disabled onclick="jobLog()">جاب حذف لاگ (غیرفعال)</button>*@
                                                            </div>
                                                        </div>
                            <div class="card-body">
                                    @if (data != null && data.Any())
                                    {
                                        <div class="rd-job-grid">
                                            @foreach (var item in data)
                                            {
                                                <article class="rd-job-card">
                                                    <div class="rd-job-head">
                                                        <span class="rd-job-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
                                                        <h6 class="rd-job-name mono" title="@item?.Id">@item?.Id</h6>
                                                    </div>
                                                    <div class="rd-job-body">
                                                        <div class="rd-job-row"><span class="rd-job-k">کرون</span><span class="rd-job-v mono">@item?.Cron</span></div>
                                                        <div class="rd-job-row"><span class="rd-job-k">اجرای بعدی</span><span class="rd-job-v">@item?.NextExecTime</span></div>
                                                        <div class="rd-job-row"><span class="rd-job-k">آخرین اجرا</span><span class="rd-job-v">@item?.LastExecTime</span></div>
                                                        <div class="rd-job-row"><span class="rd-job-k">ساخته شده</span><span class="rd-job-v">@item?.CreatedAt</span></div>
                                                    </div>
                                                    <div class="rd-job-foot">
                                                        <button type="button" class="rd-job-act rd-job-act-run" data-job="@item?.Id" onclick="rdTriggerJob(this)" title="اجرای فوری همین جاب"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>اجرای فوری</button>
                                                        <button type="button" class="rd-job-act rd-job-act-cron" data-job="@item?.Id" data-cron="@item?.Cron" onclick="rdOpenCronModal(this)" title="تغییر کرون جاب"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>تغییر کرون</button>
                                                    </div>
                                                </article>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rd-job-empty"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                            <div>هیچ جابی ثبت نشده است</div></div>
                                    }
                                    <div class="rd-modal-backdrop" id="rdCronBackdrop" aria-hidden="true"></div>
                                    <div class="rd-modal" id="rdCronModal" role="dialog" aria-modal="true">
                                        <div class="rd-modal-head"><h6>تغییر کرون جاب</h6><button type="button" class="rd-modal-x" onclick="rdCloseCronModal()" aria-label="بستن"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div>
                                        <div class="rd-modal-body">
                                            <span class="rd-modal-job mono" id="rdCronJobName"></span>
                                            <label class="rd-modal-label" for="rdCronInput">بازهٔ کرون (Cron)</label>
                                            <input type="text" id="rdCronInput" class="rd-cron-input mono" dir="ltr" spellcheck="false" autocomplete="off">
                                            <div class="rd-cron-hint">مثلاً: <span dir="ltr">*/10 * * * *</span> (هر ۱۰ دقیقه)</div>
                                        </div>
                                        <div class="rd-modal-foot">
                                            <button type="button" class="rd-modal-btn primary" onclick="rdSaveCron()">ذخیره</button>
                                            <button type="button" class="rd-modal-btn ghost" onclick="rdCloseCronModal()">انصراف</button>
                                        </div>
                                    </div>
                            </div>


                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>

<div class="modal fade" id="jobModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Job Setting</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="jobForm">
                    <div class="form-group">
               <label asp-for="IsActiveJob">وضعیت جاب : </label>
               <input id="IsActiveJob" asp-for="IsActiveJob" type="checkbox" class="form-control" required>
           </div>

           <div class="form-group">
               <label asp-for="Email"></label>
               <input id="Email" asp-for="Email" type="text" class="form-control" value="@ViewBag.Email" required>
           </div>
           <div class="form-group">
               <label asp-for="ApiKey"></label>
               <input id="ApiKey" asp-for="ApiKey" type="text" class="form-control" value="@ViewBag.ApiKey" required>
           </div>
                    <div class="form-group">
                        <label asp-for="JobPeriodTime"></label>
                        <input id="JobPeriodTime" asp-for="JobPeriodTime" type="text" class="form-control" value="@ViewBag.JobPeriodTime">
                    </div>
                    <div class="form-group">
                        <label asp-for="JobExpireMinuteTime"></label>
                        <input id="JobExpireMinuteTime" asp-for="JobExpireMinuteTime" type="text" class="form-control" value="@ViewBag.JobExpireMinuteTime">
                    </div>
                    <div class="form-group">
                        <label asp-for="FailConnectionCount"></label>
                        <input id="FailConnectionCount" asp-for="FailConnectionCount" type="text" class="form-control" value="@ViewBag.FailConnectionCount">
                    </div>
                    <div class="form-group">
                        <label asp-for="FailConnectionPercent"></label>
                        <input id="FailConnectionPercent" asp-for="FailConnectionPercent" type="text" class="form-control" value="@ViewBag.FailConnectionPercent">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">لغو</button>
                <button onclick="submitForm()" type="button" class="btn btn-success">تایید</button>
            </div>
        </div>
    </div>
</div>


