    <div class="modal fade" id="jobIpConfigModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Job Setting</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="jobForm">
                        <div class="form-group">
                            <label asp-for="IsActiveJob">وضعیت جاب : </label>
                            <input id="IsActiveJob" asp-for="IsActiveJob" type="checkbox" class="form-control" required>
                        </div>
