@using Project.Application.DTOs.Job
@using DNTPersianUtils.Core
@using Hangfire
@using Hangfire.Common
@model Project.Application.DTOs.Job.DomainJob.CreateDomainJobDTO
@{
    Layout = "_Admin";
    var data = ViewData["DetailModels"] as List<HangfireDTO>;
}

@section vendors{
    <script src="~/app-assets/vendors/js/vendors.min.js"></script>
    <!-- BEGIN Vendor JS-->
    <!-- BEGIN: Page Vendor JS-->
