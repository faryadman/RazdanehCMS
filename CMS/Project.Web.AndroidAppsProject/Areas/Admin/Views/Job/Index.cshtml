@using Project.Application.Jobs
@using Project.Domain.Jobs
@model JobDashboard
@inject Microsoft.Extensions.Options.IOptions<Project.Web.AndroidAppsProject.Jobs.NativeJobOptions> WorkerOptions
@{
    Layout = "_Admin";
    string Display(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—";
    string Status(string? value) => value switch {
        JobExecutionStatus.Running => "در حال اجرا", JobExecutionStatus.Succeeded => "موفق",
        JobExecutionStatus.Failed => "ناموفق", JobExecutionStatus.Cancelled => "متوقف‌شده",
        JobExecutionStatus.Interrupted => "قطع‌شده", _ => "هنوز اجرا نشده"
    };
}
@section scripts {
    <script src="~/adminJs/job.js" asp-append-version="true"></script>
}
<div class="content-body" dir="rtl">
    <h2>مدیریت جاب‌ها</h2>
    <a href="/Admin/Job" class="btn btn-outline-primary">تازه‌سازی وضعیت</a>
    @if (!WorkerOptions.Value.Enabled)
    {
        <div class="alert alert-info">اجرای زمان‌بند در این نمونهٔ برنامه غیرفعال است. تنظیمات و درخواست‌ها در دیتابیس ذخیره می‌شوند.</div>
    }
    <p>تنظیمات، درخواست اجرا و سابقه در دیتابیس نگهداری می‌شوند. زمان‌ها UTC هستند. برای تازه‌سازی وضعیت، صفحه را بارگذاری کنید.</p>
    <p>چرخهٔ دقیقه‌ای مثل زمان‌بندی قبلی است: عدد ۴۵ یعنی دقیقه‌های ۰ و ۴۵ هر ساعت. هنگام خاموشی، اجراهای عقب‌افتاده به یک اجرا محدود می‌شوند.</p>
    @if (Model.NeedsReview)
    {
        <div class="alert alert-warning" role="alert">اجرای نامطمئن نیازمند بررسی است. تا تأیید آن، جاب جدیدی اجرا نمی‌شود. ابتدا مطمئن شوید نمونهٔ قبلی برنامه متوقف است و اثر عملیات روی سرور و DNS بررسی شده است.</div>
    }
    <div id="job-message" class="alert" role="status" hidden></div>
    @foreach (var job in Model.Jobs)
    {
        <section class="card p-2 mb-2">
            <h3>@job.Definition.Title</h3>
            <p><code>@job.Definition.Name</code> — @Status(job.Schedule.LastStatus)</p>
            <p>آخرین شروع: <bdi>@Display(job.Schedule.LastStartedUtc)</bdi> | پایان: <bdi>@Display(job.Schedule.LastCompletedUtc)</bdi> | موعد بعدی: <bdi>@Display(job.Schedule.NextRunUtc)</bdi> | اجراهای موفق: @job.Schedule.SuccessfulExecutions</p>
            @if (job.Schedule.RunRequested) { <p>درخواست اجرای دستی از <bdi>@Display(job.Schedule.RequestedUtc)</bdi> در انتظار است.</p> }
            @if (job.Schedule.ValidationError != null) { <p class="text-danger">@job.Schedule.ValidationError</p> }
            <form action="/Admin/Job/Save" method="post" class="job-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="jobName" value="@job.Definition.Name" />
                <label><input name="IsActiveJob" type="checkbox" value="true" checked="@job.Settings.Enabled" /> فعال</label>
                <label>چرخهٔ دقیقه‌ای (۱ تا ۵۹) <input name="JobPeriodTime" type="number" min="1" max="59" required value="@job.Settings.MinuteStep" /></label>
                @if (job.Definition.Name is JobCatalog.Domain or JobCatalog.IpConfig or JobCatalog.DeleteDns)
                {
                    <label>حداقل سن دامنه / انقضای رکورد (دقیقه) <input name="JobExpireMinuteTime" type="number" min="@(job.Definition.Name == JobCatalog.DeleteDns ? 1 : 0)" required value="@job.Settings.ExpireMinutes" /></label>
                }
                @if (job.Definition.Name == JobCatalog.Domain)
                {
                    <label>حداقل تعداد شکست <input name="FailConnectionCount" type="number" min="0" required value="@job.Settings.FailureCount" /></label>
                    <label>حداقل درصد شکست <input name="FailConnectionPercent" type="number" min="0" max="100" required value="@job.Settings.FailurePercent" /></label>
                }
                <button type="submit" class="btn btn-primary">ذخیرهٔ تنظیمات</button>
            </form>
            <form action="/Admin/Job/Run" method="post" class="job-form mt-1">
                @Html.AntiForgeryToken()
                <input type="hidden" name="jobName" value="@job.Definition.Name" />
                <button type="submit" class="btn btn-outline-primary" disabled="@(!job.Schedule.Enabled || Model.NeedsReview)">ثبت اجرای دستی</button>
            </form>
        </section>
    }
    <h3>۵۰ اجرای اخیر</h3>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>جاب</th><th>شروع UTC</th><th>پایان UTC</th><th>وضعیت</th><th>کد خطا</th><th>بررسی</th></tr></thead>
            <tbody>
            @foreach (var run in Model.History)
            {
                <tr>
                    <td>@run.JobName<br /><small>@run.Id</small></td><td><bdi>@Display(run.StartedUtc)</bdi></td><td><bdi>@Display(run.CompletedUtc)</bdi></td>
                    <td>@Status(run.Status)</td><td>@(run.ErrorCode ?? "—")</td>
                    <td>
                        @if (run.NeedsReview)
                        {
                            <form action="/Admin/Job/Review" method="post" class="job-form job-review">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="executionId" value="@run.Id" />
                                <button class="btn btn-warning" type="submit">اثر عملیات را بررسی کردم؛ ادامه</button>
                            </form>
                        }
                        else if (run.ReviewedUtc != null) { <span>تأییدشده در <bdi>@Display(run.ReviewedUtc)</bdi></span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
