@section scripts{
    <script>
        disableFields();
    </script>
}
<div class="content-body">
    <section id="horizontal-vertical">
        <div class="row">
            <div class="col-12">
                <div class="card row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                                            <div class="rd-toolbar">
                                                                <div class="rd-tb-title"><span class="rd-tb-bar" aria-hidden="true"></span><h4 class="card-title mb-0">مدیریت جاب ها</h4></div>
                                                                <div class="rd-tb-group" role="group" aria-label="جاب‌ها">
                                                                <button class="btn btn-success rd-tb-btn" id="button" onclick="jobDomain()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></i>Change Domain Job</button>
                                                                <button class="btn btn-success rd-tb-btn" id="button" onclick="jobSubDomain()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg></i>Change SubDomain Job</button>
                                                                <button class="btn btn-danger rd-tb-btn" id="button" onclick="jobDeleteDnsJob()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></i>Delete Dns Records (CNAME)</button>
                                                                <button class="btn btn-success rd-tb-btn" id="button" onclick="jobIpConfigJob()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></i>Job IpConfigJob</button>
                                                                @*<button class="btn btn-success rd-tb-btn" disabled="disabled" onclick="jobLog()"><i class="rd-tb-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></i>جاب حذف لاگ (غیرفعال)</button>*@
                                                                </div>
                                                            </div>
                                                        </div>
                            <div class="card-body">
                                    <table class="table">
                                    <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Cron</th>
                                        <th>Next execution</th>
                                        <th>Last execution</th>
                                        <th>Created</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @if (data != null && data.Any())
                                    {
                                        foreach (var item in data)
                                        {
                                            <tr>
                                                <td>@item?.Id</td>
                                                <td>@item?.Cron</td>
                                                <td>@item?.NextExecTime</td>
                                                <td>@item?.LastExecTime</td>
                                                <td>@item?.CreatedAt</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5">هیچ داده‌ای موجود نیست.</td>
                                        </tr>

                                    }
                                    </tbody>
                                </table>
                            </div>


                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>

<div class="modal fade" id="jobModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Job Setting</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="jobForm">
                    <div class="form-group">
               <label asp-for="IsActiveJob">وضعیت جاب : </label>
               <input id="IsActiveJob" asp-for="IsActiveJob" type="checkbox" class="form-control" required>
           </div>

           <div class="form-group">
               <label asp-for="Email"></label>
               <input id="Email" asp-for="Email" type="text" class="form-control" value="@ViewBag.Email" required>
           </div>
           <div class="form-group">
               <label asp-for="ApiKey"></label>
               <input id="ApiKey" asp-for="ApiKey" type="text" class="form-control" value="@ViewBag.ApiKey" required>
           </div>
                    <div class="form-group">
                        <label asp-for="JobPeriodTime"></label>
                        <input id="JobPeriodTime" asp-for="JobPeriodTime" type="text" class="form-control" value="@ViewBag.JobPeriodTime">
                    </div>
                    <div class="form-group">
                        <label asp-for="JobExpireMinuteTime"></label>
                        <input id="JobExpireMinuteTime" asp-for="JobExpireMinuteTime" type="text" class="form-control" value="@ViewBag.JobExpireMinuteTime">
                    </div>
                    <div class="form-group">
                        <label asp-for="FailConnectionCount"></label>
                        <input id="FailConnectionCount" asp-for="FailConnectionCount" type="text" class="form-control" value="@ViewBag.FailConnectionCount">
                    </div>
                    <div class="form-group">
                        <label asp-for="FailConnectionPercent"></label>
                        <input id="FailConnectionPercent" asp-for="FailConnectionPercent" type="text" class="form-control" value="@ViewBag.FailConnectionPercent">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">لغو</button>
                <button onclick="submitForm()" type="button" class="btn btn-success">تایید</button>
            </div>
        </div>
    </div>
</div>


