<!DOCTYPE html>
<html class="loading" lang="fa" data-textdirection="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <title>@(ViewBag.PageTitle == null ? "پنل مدیریت" : ViewBag.PageTitle)</title>
    <link rel="apple-touch-icon" href="/favicon.ico">
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
    @*<link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600" rel="stylesheet">*@

    <!-- BEGIN: Vendor CSS-->
    <link rel="stylesheet" type="text/css" href="/app-assets/vendors/css/vendors-rtl.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/vendors/css/ui/prism.min.css">
    <link rel="stylesheet" href="~/app-assets/fontawesome/font-awesome.min.css" integrity="sha384-wvfXpqpZZVQGK6TAh5PVlGOfQNHSoD2xbE+QkPxCAFlNEevoEH3Sl0sibVcOQVnN" crossorigin="anonymous">
    @RenderSection("vendorstyles", false)
    <!-- END: Vendor CSS-->
    <!-- BEGIN: Theme CSS-->
    <link rel="stylesheet" type="text/css" href="/app-assets/css-rtl/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/css-rtl/bootstrap-extended.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/css-rtl/colors.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/css-rtl/components.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/css-rtl/themes/dark-layout.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/css-rtl/themes/semi-dark-layout.min.css">
    <link rel="stylesheet" href="~/app-assets/toastr/toastr.min.css" />
    <!-- BEGIN: Page CSS-->
    <link rel="stylesheet" type="text/css" href="/app-assets/css-rtl/core/menu/menu-types/vertical-menu.min.css">
    @RenderSection("styles", false)
    <!-- END: Page CSS-->
    <!-- BEGIN: Custom CSS-->
    <link rel="stylesheet" type="text/css" href="/app-assets/css-rtl/custom-rtl.css">
    <!-- END: Custom CSS-->
    <link href="~/app-assets/fonts/font.css" rel="stylesheet" />
    <link href="~/app-assets/jqueryUI/jquery-ui.min.css" rel="stylesheet" />

    <style>
        .swal2-content > a {
            color: red !important
        }

        .myBadge {
            font-size: 14px !important
        }

        #swal2-content {
            direction: ltr;
        }

        .swal2-actions {
            direction: ltr;
        }
    </style>

</head>
<body id="body" style="visibility:visible;font-size:15px;font-weight:bold" class="vertical-layout vertical-menu-modern 2-columns  navbar-floating fixed-footer menu-collapsed" data-open="click" data-menu="vertical-menu-modern" data-col="2-columns">

    <input value="@User.Identity.Name" id="username" type="hidden" />
    <!-- BEGIN: Header-->
    <div class="content-overlay"></div>
    <div class="header-navbar-shadow"></div>
    <nav class="header-navbar navbar-expand-lg navbar navbar-with-menu floating-nav navbar-light navbar-shadow">
        <div class="navbar-wrapper">
            <div class="navbar-container content">
                <div class="navbar-collapse" id="navbar-mobile">
                    <div class="mr-auto float-left bookmark-wrapper d-flex align-items-center">
                        <ul class="nav navbar-nav">
                            <li class="nav-item mobile-menu d-xl-none mr-auto">
                                <a class="nav-link nav-menu-main menu-toggle hidden-xs" id="menuButton" href="#">
                                    <i class="ficon feather icon-menu"></i>
                                </a>
                            </li>
                        </ul>
                        <ul class="nav navbar-nav bookmark-icons">
                            <li class="nav-item d-none d-lg-block">
                                <a class="nav-link" href="#" data-toggle="tooltip" data-placement="top">
                                    <i class="ficon feather icon-sidebar"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <ul id="alarms" class="d-inline-block row" style="position:absolute;top:100%;left:0;z-index:9999;list-style:none;padding:10px;margin:20px 0;border-radius:10px;">
                    </ul>


                    <ul class="nav navbar-nav float-right">
                        <li class="nav-item d-none d-lg-block">
                            <a class="nav-link nav-link-expand">
                                <i class="ficon feather icon-maximize"></i>
                            </a>
                        </li>
                        <li class="nav-item nav-search">
                            <a class="nav-link nav-link-search">
                                <i class="ficon feather icon-search"></i>
                            </a>
                            <div class="search-input">
                                <div class="search-input-icon"><i class="feather icon-search primary"></i></div>
                                <input class="input" type="text" placeholder="جستجو..." tabindex="-1"
                                       data-search="starter-list">
                                <div class="search-input-close"><i class="feather icon-x"></i></div>
                                <ul class="search-list"></ul>
                            </div>
                        </li>
                        <li class="dropdown dropdown-user nav-item">
                            <a class="dropdown-toggle nav-link dropdown-user-link" href="#" data-toggle="dropdown">
                                <div class="user-nav d-sm-flex d-none">
                                    <span class="user-name text-bold-600">@User.Identity.Name</span>
                                    <span class="user-status">آنلاین</span>
                                </div>

                            </a>
                            <div class="dropdown-menu dropdown-menu-right">
                                @*<a class="dropdown-item" href="#"><i class="feather icon-user"></i> Edit Profile</a>
                                <a class="dropdown-item" href="#"><i class="feather icon-mail"></i> My Inbox</a>
                                <a class="dropdown-item" href="#"><i class="feather icon-check-square"></i> Task</a>
                                <a class="dropdown-item" href="#"><i class="feather icon-message-square"></i> Chats</a>
                                <div class="dropdown-divider"></div>*@
                                <a class="dropdown-item" asp-action="logout" asp-controller="account"><i class="feather icon-power"></i> خروج</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
    <!-- END: Header-->
    <!-- BEGIN: Main Menu-->
    <div class="main-menu menu-fixed menu-light menu-accordion menu-shadow" data-scroll-to-active="true">
        <div class="navbar-header expanded">
            <ul class="nav navbar-nav flex-row">
                <li class="nav-item mr-auto">
                    <a class="navbar-brand" href="#">
                        <div class="brand-logo"></div>
                        <h2 class="brand-text mb-0">داشبورد</h2>
                    </a>
                </li>
                <li class="nav-item nav-toggle">
                    <a class="nav-link modern-nav-toggle pr-0" data-toggle="collapse">
                        <i class="feather icon-x d-block d-xl-none font-medium-4 primary toggle-icon"></i>
                        <i class="toggle-icon feather icon-disc font-medium-4 d-none d-xl-block primary" data-ticon="icon-disc"></i>
                    </a>
                </li>
            </ul>
        </div>
        <div class="shadow-bottom"></div>
        <div class="main-menu-content">
            <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">

                <li class=" nav-item">
                    @*<a asp-area="admin" asp-controller="dashboard" asp-action="index">*@
                    <a href="#">
                        <i class="feather icon-circle"></i>
                        <span class="menu-title">داشبورد</span>
                    </a>
                </li>
                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="apps" asp-action="index">
                        <img style="max-width:25px!important" src="~/icons/setting.png" />
                        <span class="menu-title">لیست اپ ها</span>
                    </a>
                </li>

                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="groups" asp-action="index">
                        <img style="max-width:25px!important" src="~/icons/group.png" />
                        <span class="menu-title">لیست گروه ها</span>
                    </a>
                </li>

                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="servers" asp-action="index">
                        @*<i class="feather icon-circle"></i>*@
                        <img style="max-width:25px!important" src="~/icons/server.png"/>
                        <span class="menu-title">لیست سرور ها</span>
                    </a>
                </li>

                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="groups" asp-action="adindex">
                        <img style="max-width:25px!important" src="~/icons/adgroup.png" />
                        <span class="menu-title">لیست گروه های تبلیغاتی</span>
                    </a>
                </li>

                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="servers" asp-action="adindex">
                        <img style="max-width:25px!important" src="~/icons/adserver.png" />
                        <span class="menu-title">لیست سرور های تبلیغاتی</span>
                    </a>
                </li>
                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="servers" asp-action="AllLogs">
                        <i class="feather icon-circle"></i>
                        <span class="menu-title">آمار کلی لاگ ها</span>
                    </a>
                </li>

                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="servers" asp-action="BlackList">
                        <img style="max-width:25px!important" src="~/icons/blacklist.png" />
                        <span class="menu-title">لیست بلک لیست ها</span>
                    </a>
                </li>

                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="Operator" asp-action="index">
                        <img style="max-width:25px!important" src="~/icons/opertaor.png" />
                        <span class="menu-title">کد شناسایی اپراتور ها</span>
                    </a>
                </li>

                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="isp" asp-action="index">
                        <img style="max-width:25px!important" src="~/icons/isp.png" />
                        <span class="menu-title">کد شناسایی isp ها</span>
                    </a>
                </li>
                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="Job" asp-action="index">
                        <img style="max-width:25px!important" src="~/icons/job.png" />
                        <span class="menu-title">مدیریت جاب ها</span>
                    </a>
                </li>
                <li class=" nav-item">
                    <a asp-area="admin" asp-controller="account" asp-action="logout">
                        <i class="feather icon-log-out"></i>
                        <span class="menu-title" data-i18n="Logout">خروج</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <!-- END: Main Menu-->
    <!-- BEGIN: Content-->
    <div class="app-content content">
        <div class="content-overlay"></div>
        <div class="header-navbar-shadow"></div>
        <div class="content-wrapper" id="wrapper">
            @RenderBody()
        </div>
    </div>
    <!-- END: Content-->

    <div class="sidenav-overlay"></div>
    <div class="drag-target"></div>

    <!-- BEGIN: Footer-->
    <footer class="footer footer-static footer-light">
        <p class="clearfix blue-grey lighten-2 mb-0">
            <span class="float-md-left d-block d-md-inline-block mt-25">
                &copy; 1401
                @*<a class="text-bold-800 grey darken-2" href="http://niknet.co/" target="_blank">نیک نت</a>*@
            </span>
            <button class="btn btn-primary btn-icon scroll-top" type="button"><i class="feather icon-arrow-up"></i></button>
        </p>
    </footer>


    <script src="/app-assets/vendors/js/vendors.min.js"></script>
    <script src="~/app-assets/vendors/js/forms/select/select2.full.min.js"></script>
    <script src="~/app-assets/toastr/toastr.min.js"></script>
    <script src="~/app-assets/sweetalert/sweetalert2@10.js"></script>
    <script src="/app-assets/js/core/app-menu.js"></script>
    <script src="/app-assets/js/core/app.js"></script>
    <script src="~/app-assets/jqueryUI/jquery-ui.min.js"></script>
    <script src="~/jquery.cookie.js"></script>
    <script src="~/adminJs/admin.js"></script>
    <script>
        $('#menuButton').on('click', function () {
            setTimeout(function () {
                $('#body').addClass('menu-open');
                $('#body').removeClass('menu-hide');
            }, 500);
        })
    </script>
    @RenderSection("vendors", false)
    <!-- END: Theme JS-->
    <!-- BEGIN: Page JS-->
    @*<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.blockUI/2.70/jquery.blockUI.min.js" integrity="sha512-eYSzo+20ajZMRsjxB6L7eyqo5kuXuS2+wEbbOkpaur+sA2shQameiJiWEzCIDwJqaB0a4a6tCuEvCOBHUg3Skg==" crossorigin="anonymous"></script>*@
    @RenderSection("scripts", false)
</body>

</html>